# Dashboard and scheduler security
DASHBOARD_KEY=replace-with-a-long-random-password
CRON_SECRET=replace-with-a-different-long-random-secret
# Public HTTPS deployment URL. TikTok must verify this domain or URL prefix.
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Etsy public catalogue
ETSY_API_KEY=your-etsy-keystring-and-shared-secret
ETSY_SHOP_ID=your-numeric-shop-id
ETSY_SHOP_URL=https://www.etsy.com/uk/shop/NewForest3D
ETSY_REFRESH_TOKEN=

# Persistent run history (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta: Instagram professional account and Facebook Page
META_GRAPH_VERSION=v24.0
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_BIO_HAS_SHOP_LINK=true
FACEBOOK_PAGE_ID=

# Pinterest
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# X (OAuth 1.0a user context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
